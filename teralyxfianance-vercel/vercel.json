{
  "version": 2,
  "builds": [
    { "src": "teralyxfianance-vercel/index.html", "use": "@vercel/static" },
    { "src": "teralyxfianance-vercel/api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/teralyxfianance-vercel/api/chat.js" },
    { "src": "/api/create-user", "dest": "/teralyxfianance-vercel/api/create-user.js" },
    { "src": "/(.*)", "dest": "/teralyxfianance-vercel/index.html" }
  ]
}
